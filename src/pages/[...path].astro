---
import Layout from '../layouts/Layout.astro';
import PostsGallery from '../components/PostsGallery.astro';
import { getAllPosts, getCategories, getPages } from '../lib/wordpress';
import type { PostDetail, Category, Page } from '../lib/wordpress';

export async function getStaticPaths() {
  const [posts, categories, pages] = await Promise.all([
    getAllPosts(),
    getCategories(),
    getPages(),
  ]);

  const postPaths = posts.map((post) => ({
    params: { path: post.uri.replace(/^\//, '') },
    props: { kind: 'post' as const, post },
  }));

  const categoryPaths = categories.map((category) => ({
    params: { path: category.uri.replace(/^\//, '') },
    props: {
      kind: 'category' as const,
      category,
      categoryPosts: posts.filter((p) => p.categories.some((c) => c.uri === category.uri)),
    },
  }));

  const pagePaths = pages.map((page) => ({
    params: { path: page.uri.replace(/^\//, '') },
    props: { kind: 'page' as const, page },
  }));

  return [...postPaths, ...categoryPaths, ...pagePaths];
}

type Props =
  | { kind: 'post'; post: PostDetail }
  | { kind: 'category'; category: Category; categoryPosts: PostDetail[] }
  | { kind: 'page'; page: Page };

const props = Astro.props as Props;
---

{props.kind === 'post' && (
  <Layout seo={props.post.seo?.fullHead}>
    <article class="long-doc">
      <header class="long-doc__head">
        {props.post.categories[0] && (
          <a href={props.post.categories[0].uri} class="long-doc__tag">{props.post.categories[0].name}</a>
        )}
        <h1 class="long-doc__title" set:html={props.post.title} />
        <time datetime={props.post.date} class="long-doc__meta">
          {new Date(props.post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </header>

      <div class="post-content" set:html={props.post.content} />
    </article>
  </Layout>
)}

{props.kind === 'category' && (
  <Layout title={`${props.category.name} – Riff Valley`}>
    <div class="archive-head">
      <h1 class="archive-title">{props.category.name}</h1>
      {props.category.description && (
        <p class="archive-desc" set:html={props.category.description} />
      )}
    </div>
    <div class="archive-body">
      <PostsGallery posts={props.categoryPosts} limit={0} />
    </div>
  </Layout>
)}

{props.kind === 'page' && (
  <Layout seo={props.page.seo?.fullHead} title={props.page.title}>
    <article class="long-doc">
      <header class="long-doc__head">
        <h1 class="long-doc__title" set:html={props.page.title} />
      </header>
      <div class="post-content" set:html={props.page.content} />
    </article>
  </Layout>
)}

<style>
  .long-doc {
    max-width: var(--max-width-site, 1280px);
    margin: 0 auto;
    padding: var(--space-2xl, 4rem) var(--space-lg, 1.5rem) var(--space-3xl, 6rem);
  }

  .long-doc__head {
    margin-bottom: var(--space-xl, 2.5rem);
  }

  .long-doc__tag {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in oklch, var(--color-accent) 14%, transparent);
    text-decoration: none;
  }

  .long-doc__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.6rem;
  }

  .long-doc__meta {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .archive-head {
    max-width: var(--max-width-site, 1280px);
    margin: 0 auto;
    padding: var(--space-2xl, 4rem) var(--space-lg, 1.5rem) var(--space-lg, 1.5rem);
  }

  .archive-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .archive-desc {
    max-width: 60ch;
    color: var(--color-ink-2);
  }

  .archive-body {
    padding: 0 var(--space-lg, 1.5rem) var(--space-3xl, 6rem);
  }
</style>
