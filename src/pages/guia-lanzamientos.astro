---
import Layout from '../layouts/Layout.astro';
import GuiaLanzamientosIsland from '../features/releases/components/GuiaLanzamientosIsland.vue';
---

<Layout title="Guía de lanzamientos – Riff Valley">
  <div class="guide bloom-canvas">
    <div class="guide-inner">
      <h1 class="guide-title">Guía de lanzamientos</h1>
      <p class="guide-lede">
        Calendario de discos por fecha de lanzamiento — metal, rock y hardcore.
      </p>

      <GuiaLanzamientosIsland client:load />
    </div>
  </div>
</Layout>

<style>
  .guide-inner {
    max-width: var(--max-width-site, 1280px);
    margin: 0 auto;
    padding: var(--space-2xl, 4rem) var(--space-lg, 1.5rem) var(--space-3xl, 6rem);
  }

  .guide-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }

  .guide-lede {
    max-width: 60ch;
    color: var(--color-ink-2);
    margin: 0 0 var(--space-xl, 2.5rem);
  }
</style>
