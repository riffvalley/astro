---
import { formatScore, scoreColor, type HeaderNavigationItem } from '../../features/editorial';

interface SocialLink {
  label: string;
  href: string;
  path: string;
}

interface Props {
  nav: HeaderNavigationItem[];
  social?: SocialLink[];
  variant: 'desktop' | 'mobile';
}

const { nav, social = [], variant } = Astro.props;
---

{variant === 'desktop' ? (
  <nav aria-label="Navegación principal" class="main-nav hidden md:flex">
    {nav.map(item => (
      <div class="nav-item">
        <a href={item.href} class="nav-link">
          {item.label}
          {item.children && <span class="nav-caret" aria-hidden="true"></span>}
        </a>
        {item.children && (
          <div class="mega-menu" data-active="0">
            <div class="mega-menu-list">
              {item.children.map((child, i) => (
                <a href={child.href} class="mega-menu-item" data-idx={i}>{child.label}</a>
              ))}
            </div>
            <div class="mega-menu-preview">
              {item.children.map((child, i) => (
                <div class="mega-menu-panel" data-panel={i}>
                  <div class="mega-menu-panel-head">
                    <span class="mega-menu-panel-title">{child.label}</span>
                    <a href={child.href} class="mega-menu-panel-link">Ver todo →</a>
                  </div>
                  {child.previewPosts.length > 0 ? (
                    <div class="mega-menu-posts">
                      {child.previewPosts.map(({ href, imageUrl, title, score }) => (
                        <a href={href} class="mega-menu-post">
                          {imageUrl !== null && (
                            <img src={imageUrl} alt="" loading="lazy" class="mega-menu-post-img" />
                          )}
                          <span class="mega-menu-post-title">{title}</span>
                          {score !== null && (
                            <span class="mega-menu-post-score" style={`--score-color:${scoreColor(score)}`}>{formatScore(score)}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  ) : (
                    <p class="mega-menu-empty">Explora esta sección →</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}
        {!item.children && item.previewPosts && item.previewPosts.length > 0 && (
          <div class="mega-menu mega-menu--simple">
            <div class="mega-menu-preview">
              <div class="mega-menu-panel" data-panel="0">
                <div class="mega-menu-panel-head">
                  <span class="mega-menu-panel-title">{item.label}</span>
                  <a href={item.href} class="mega-menu-panel-link">Ver todo →</a>
                </div>
                <div class="mega-menu-posts">
                  {item.previewPosts.map(({ href, imageUrl, title, score }) => (
                    <a href={href} class="mega-menu-post">
                      {imageUrl !== null && (
                        <img src={imageUrl} alt="" loading="lazy" class="mega-menu-post-img" />
                      )}
                      <span class="mega-menu-post-title">{title}</span>
                      {score !== null && (
                        <span class="mega-menu-post-score" style={`--score-color:${scoreColor(score)}`}>{formatScore(score)}</span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    ))}
  </nav>
) : (
  <>
    <div id="mobile-menu" class="mobile-menu md:hidden" hidden>
      <nav aria-label="Navegación principal (móvil)">
        {nav.map(item => (
          <div class="mobile-group">
            <a href={item.href} class="mobile-link mobile-link--top">{item.label}</a>
            {item.children && (
              <div class="mobile-children">
                {item.children.map(child => (
                  <a href={child.href} class="mobile-link mobile-link--child">{child.label}</a>
                ))}
              </div>
            )}
          </div>
        ))}
        <a href="/contacto" class="mobile-link mobile-link--top">Contacto</a>
      </nav>

      <ul class="mobile-social">
        {social.map(item => (
          <li>
            <a href={item.href} target="_blank" rel="noopener nofollow" aria-label={item.label} class="mobile-social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={item.path}></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <script>
      const menuBtn = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      function closeMenu() {
        mobileMenu?.setAttribute('hidden', '');
        menuBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      function toggleMenu() {
        const isOpen = !mobileMenu?.hasAttribute('hidden');
        if (isOpen) {
          closeMenu();
        } else {
          mobileMenu?.removeAttribute('hidden');
          menuBtn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
      }

      menuBtn?.addEventListener('click', toggleMenu);
      mobileMenu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu?.hasAttribute('hidden')) closeMenu();
      });
      window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) closeMenu();
      });

      document.querySelectorAll('.nav-item').forEach(navItem => {
        const megaMenu = navItem.querySelector('.mega-menu[data-active]');
        if (!megaMenu) return;

        megaMenu.querySelectorAll('.mega-menu-item').forEach(item => {
          const setActive = () => {
            megaMenu.setAttribute('data-active', item.getAttribute('data-idx') ?? '0');
          };
          item.addEventListener('mouseenter', setActive);
          item.addEventListener('focus', setActive);
        });

        navItem.addEventListener('mouseleave', () => {
          megaMenu.setAttribute('data-active', '0');
        });
      });
    </script>
  </>
)}

<style>
  .main-nav {
    grid-column: 2;
    justify-self: center;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-item { position: relative; }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.7rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color var(--dur-micro, 120ms) var(--ease-out, ease);
  }

  .nav-caret {
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    opacity: 0.7;
    transition: transform 160ms var(--ease-out, ease);
  }

  .nav-item:hover .nav-caret,
  .nav-item:focus-within .nav-caret {
    transform: rotate(225deg) translateY(1px);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 9999px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 200ms var(--ease-out, ease);
  }

  .nav-link:hover::after,
  .nav-item:focus-within .nav-link::after {
    transform: scaleX(1);
  }

  .nav-link:hover,
  .nav-item:focus-within .nav-link { color: #ffffff; }

  .mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    padding-top: 0.6rem;
    transform: translateX(-50%) translateY(-6px);
    z-index: var(--z-dropdown, 100);
    display: flex;
    width: max-content;
    max-width: min(640px, 90vw);
    background: var(--color-paper-2);
    border: 1px solid var(--color-rule);
    border-radius: 14px;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms var(--ease-out, ease), transform 160ms var(--ease-out, ease), visibility 160ms;
  }

  .mega-menu::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    transform: translateX(-50%) rotate(45deg);
    background: var(--color-paper-2);
    border-left: 1px solid var(--color-rule);
    border-top: 1px solid var(--color-rule);
  }

  .nav-item:hover .mega-menu,
  .nav-item:focus-within .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .mega-menu-list {
    flex-shrink: 0;
    width: 210px;
    max-height: 22rem;
    padding: 0.6rem;
    border-right: 1px solid var(--color-rule-2);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    overflow-y: auto;
  }

  .mega-menu-item {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 120ms var(--ease-out, ease), color 120ms var(--ease-out, ease);
  }

  .mega-menu-item:hover,
  .mega-menu-item:focus-visible {
    background: color-mix(in oklch, var(--color-accent) 12%, var(--color-paper-3));
    color: var(--color-ink);
  }

  .mega-menu-preview {
    flex: 1;
    min-width: 0;
    padding: 0.9rem 1rem;
  }

  .mega-menu-panel { display: none; }

  /* La categoría activa se guarda en data-active en el script de este
     componente para conservar el último panel visto al mover el ratón hacia
     la cuadrícula de posts. */
  .mega-menu[data-active="0"] .mega-menu-panel[data-panel="0"],
  .mega-menu[data-active="1"] .mega-menu-panel[data-panel="1"],
  .mega-menu[data-active="2"] .mega-menu-panel[data-panel="2"],
  .mega-menu[data-active="3"] .mega-menu-panel[data-panel="3"],
  .mega-menu[data-active="4"] .mega-menu-panel[data-panel="4"],
  .mega-menu[data-active="5"] .mega-menu-panel[data-panel="5"],
  .mega-menu[data-active="6"] .mega-menu-panel[data-panel="6"],
  .mega-menu[data-active="7"] .mega-menu-panel[data-panel="7"],
  .mega-menu[data-active="8"] .mega-menu-panel[data-panel="8"] {
    display: block;
  }

  .mega-menu--simple .mega-menu-panel { display: block; }

  .mega-menu-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .mega-menu-panel-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .mega-menu-panel-link {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .mega-menu-panel-link:hover { text-decoration: underline; }

  .mega-menu-posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .mega-menu-post {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
  }

  .mega-menu-post-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    background: var(--color-paper-3);
    display: block;
  }

  .mega-menu-post-title {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 120ms var(--ease-out, ease);
  }

  .mega-menu-post:hover .mega-menu-post-title { color: var(--color-accent); }

  .mega-menu-post-score {
    align-self: flex-start;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.4;
    color: #ffffff;
    background: var(--score-color);
  }

  .mega-menu--simple .mega-menu-preview { width: min(480px, 90vw); }

  .mega-menu-empty {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
  }

  .mobile-menu {
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule);
    padding: var(--space-md, 1rem) var(--space-lg, 1.5rem) var(--space-xl, 2.5rem);
  }

  .mobile-group {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-rule-2);
  }

  .mobile-group:last-of-type { border-bottom: none; }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .mobile-link--top {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .mobile-children {
    display: flex;
    flex-direction: column;
    padding-left: 1rem;
  }

  .mobile-link--child {
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }

  .mobile-link:hover,
  .mobile-link:focus-visible { color: var(--color-accent); }

  .mobile-social {
    display: flex;
    justify-content: center;
    gap: 1.1rem;
    list-style: none;
    margin: var(--space-lg, 1.5rem) 0 0;
    padding-top: var(--space-md, 1rem);
    border-top: 1px solid var(--color-rule-2);
  }

  .mobile-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-ink-2);
  }

  .mobile-social-link svg { width: 19px; height: 19px; }

  .mobile-social-link:hover { color: var(--color-accent); }
</style>
