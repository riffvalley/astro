---
import Search from './Search.astro';
import { getAllPosts } from '../../features/editorial/api/wordpress';
import { buildHeaderNavigation } from '../../features/editorial';
import HeaderNavigation from './HeaderNavigation.astro';

// getAllPosts() está memoizada a nivel de módulo — index.astro/[...path].astro
// ya la llaman, así que reutiliza la misma promesa/resultado sin repetir la
// paginación completa contra WPGraphQL.
const allPosts = await getAllPosts();

const nav = buildHeaderNavigation(allPosts);

