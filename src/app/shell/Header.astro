---

<header class="site-header" id="site-header">
  <div class="brand-band">
    <div class="landscape" aria-hidden="true">
      <img src="/bg-mountains-day.png" alt="" class="landscape__image" />
      <img src="/bg-mountains-night.png" alt="" class="landscape__image landscape__night" />
    </div>

    <div class="landscape-compact" aria-hidden="true">
      <img src="/bg-mountains-compact-day.png" alt="" class="landscape-compact__image" />
      <img src="/bg-mountains-compact-night.png" alt="" class="landscape-compact__image landscape-compact__night" />
    </div>

    <div class="icon-bar">
      <ul class="icon-list">
        {social.map(item => (
          <li>
            <a href={item.href} target="_blank" rel="noopener nofollow" aria-label={item.label} class="social-link">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={item.path}></path></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="header-inner">
      <a href="/" aria-label="Riff Valley" class="logo-link logo-link--hero" tabindex="-1" aria-hidden="true">
        <img src="/LOGO-RIFF-VALLEY.svg" alt="" width="32" height="32" class="logo-mark" />
        <span class="logo-word">Riff Valley</span>
      </a>
      <a href="/" aria-label="Riff Valley" class="logo-link logo-link--inline">
        <img src="/LOGO-RIFF-VALLEY.svg" alt="" width="32" height="32" class="logo-mark" />
        <span class="logo-word">Riff Valley</span>
      </a>

      <HeaderNavigation nav={nav} variant="desktop" />

      <div class="header-actions">
        <Search />

        <button id="theme-toggle" aria-label="Cambiar tema" class="icon-btn">
          <svg class="light:hidden w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10A5 5 0 0012 7z" />
          </svg>
          <svg class="hidden light:block w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>

        <a href="/contacto" class="contact-link hidden lg:inline">Contacto</a>

        <button id="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" class="icon-btn menu-btn">
          <svg class="w-[20px] h-[20px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <HeaderNavigation nav={nav} social={social} variant="mobile" />
</header>

<script>
  const header = document.getElementById('site-header');
  let ticking = false;

  function updateScrollState() {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateScrollState);
      ticking = true;
    }
  }, { passive: true });
  updateScrollState();

  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  });

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 200);
  }

  .brand-band {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 19rem;
    transition: min-height 320ms var(--ease-out, ease);
  }

  .site-header.is-scrolled .brand-band {
    min-height: 4.5rem;
    box-shadow: 0 8px 28px -18px rgba(0, 0, 0, 0.6);
  }

  /* Paisaje día/noche del hero: dos imágenes apiladas que se funden entre sí
     por opacidad según el tema real del sitio (.light en <html> = modo
     claro), no por un temporizador propio — solo se ve en el estado hero,
     porque la capa compacta (opaca) las tapa por completo en cuanto se hace
     scroll. */
  .landscape {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .landscape__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .landscape__night {
    opacity: 0;
    transition: opacity 2.5s ease-in-out;
  }

  html:not(.light) .landscape__night {
    opacity: 1;
  }

  /* Misma pareja de imágenes recortada a la franja de picos más altos, para
     el header compacto — aparece con el scroll y también sigue el tema
     día/noche, igual que la versión hero. */
  .landscape-compact {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 320ms var(--ease-out, ease);
  }

  .site-header.is-scrolled .landscape-compact {
    opacity: 1;
  }

  .landscape-compact__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .landscape-compact__night {
    opacity: 0;
    transition: opacity 2.5s ease-in-out;
  }

  html:not(.light) .landscape-compact__night {
    opacity: 1;
  }

  .brand-band::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to bottom, rgba(10, 4, 30, 0.12), rgba(10, 4, 30, 0.55));
    pointer-events: none;
  }

  .icon-bar {
    position: relative;
    z-index: 3;
    display: none;
  }

  @media (min-width: 48rem) {
    .icon-bar { display: block; }
  }

  .icon-list {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0.45rem var(--space-lg, 1.5rem) 0.15rem;
    max-width: var(--max-width-site, 1280px);
    margin-inline: auto;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: rgba(255, 255, 255, 0.85);
    transition: color var(--dur-micro, 120ms) var(--ease-out, ease), transform var(--dur-micro, 120ms) var(--ease-out, ease);
  }

  .social-link svg { width: 19px; height: 19px; }

  .social-link:hover { color: #ffffff; transform: translateY(-1px); }

  .header-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: var(--max-width-site, 1280px);
    margin-left: auto;
    margin-right: auto;
    margin-top: auto;
    margin-bottom: 0;
    padding: 0.5rem var(--space-lg, 1.5rem) 0.65rem;
  }

  /* Dos logos superpuestos que se cruzan por opacidad (nunca cambian de
     `position`) — así la transición es siempre una animación suave, sin el
     salto instantáneo que daba alternar position:absolute/static en un único
     elemento a mitad de la animación de scroll. */
  .logo-link--hero {
    position: absolute;
    left: 50%;
    bottom: 100%;
    transform: translateX(-50%);
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    opacity: 1;
    transition: opacity 320ms var(--ease-out, ease);
  }

  .logo-link--hero .logo-mark { height: 84px; width: 84px; }

  .logo-link--hero .logo-word { font-size: clamp(3rem, 5vw + 1.5rem, 5rem); }

  .site-header.is-scrolled .logo-link--hero {
    opacity: 0;
    pointer-events: none;
  }

  .logo-link--inline {
    grid-column: 1;
    justify-self: end;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms var(--ease-out, ease);
  }

  .logo-link--inline .logo-mark { height: 40px; width: 40px; }

  .logo-link--inline .logo-word { font-size: 1.85rem; }

  .site-header.is-scrolled .logo-link--inline {
    opacity: 1;
    pointer-events: auto;
  }

  .logo-mark {
    display: block;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,.4));
  }

  .logo-word {
    font-family: var(--font-outlier);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0,0,0,.35);
    white-space: nowrap;
  }

  .header-actions {
    grid-column: 3;
    justify-self: start;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: background var(--dur-micro, 120ms) var(--ease-out, ease), color var(--dur-micro, 120ms) var(--ease-out, ease);
  }

  .icon-btn:hover { background: rgba(255, 255, 255, 0.14); color: #ffffff; }

  /* El botón de hamburguesa reutiliza .icon-btn (display:flex) — esta regla,
     al ir después en la cascada dentro del mismo stylesheet con scope, es la
     que manda a partir de md y evita que quede visible en escritorio. */
  @media (min-width: 48rem) {
    .menu-btn { display: none; }
  }

  .contact-link {
    margin-left: 0.5rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    transition: color var(--dur-micro, 120ms) var(--ease-out, ease);
  }

  .contact-link:hover { color: #ffffff; }

</style>
