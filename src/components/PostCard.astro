---
import type { Post } from '../features/editorial/api/wordpress';

interface Props {
  post: Post;
  size?: 'lg' | 'md' | 'sm' | 'xs';
  showExcerpt?: boolean;
}

const { post, size = 'md', showExcerpt = false } = Astro.props;
// La categoría como pill no aporta nada dentro de un riel que ya es esa
// categoría (p.ej. todo el riel de Crónicas mostrando "CRÓNICAS" en cada
// tarjeta) — mostramos el autor en su lugar, salvo el genérico "Riff
// Valley" (roundups de novedades, sin autor real detrás).
const authorName = post.author?.node.name;
const authorAvatar = post.author?.node.avatar?.url;
const showAuthor = !!authorName && authorName !== 'Riff Valley';
---

<a href={post.uri} class={`post-card post-card--${size}`}>
  {post.featuredImage?.node.sourceUrl ? (
    <img
      src={post.featuredImage.node.sourceUrl}
      alt={post.featuredImage.node.altText || ''}
      loading="lazy"
      width="480"
      height="320"
      class="card-img"
    />
  ) : (
    <div class="card-placeholder" aria-hidden="true"></div>
  )}
  <div class="card-body">
    <h3 class="card-title" set:html={post.title} />
    {showExcerpt && (post as any).excerpt && (
      <div class="card-excerpt" set:html={(post as any).excerpt} />
    )}
    {size !== 'xs' && (
      <div class="card-meta">
        {showAuthor && (
          <span class="card-byline">
            {authorAvatar && <img src={authorAvatar} alt="" class="card-avatar" />}
            {authorName}
          </span>
        )}
        <time datetime={post.date} class="card-date">
          {new Date(post.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
        </time>
      </div>
    )}
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-card, 12px);
    overflow: hidden;
    background: var(--color-paper-2);
    /* Easing con ligero rebote ("back ease out") en vez de una curva lineal
       de salida — el lift se queda en los 1-2px que marca design.md, pero
       el propio movimiento se siente más vivo por cómo llega, no por
       cuánto se mueve. */
    transition: background 260ms var(--ease-out, ease),
                transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .post-card:hover {
    background: var(--color-paper-3);
    transform: translateY(-2px);
  }

  .card-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    transition: opacity var(--dur-short, 220ms) var(--ease-out, ease),
                transform 480ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .post-card--lg .card-img {
    /* Resolución nativa, como en Reviews — un crop 16:9/3:1 sobre fotos de
       entrevista (normalmente retrato o full-body) recortaba caras y
       manos de forma horrible. Sin aspect-ratio ni object-fit, se ve la
       foto entera y la tarjeta se adapta a su tamaño real. */
    width: auto;
    height: auto;
    max-width: 100%;
    aspect-ratio: auto;
    object-fit: contain;
    margin: 0 auto;
  }
  .post-card--sm .card-img { aspect-ratio: 4 / 3; }
  .post-card--xs .card-img { aspect-ratio: 1 / 1; }

  .post-card:hover .card-img { opacity: 0.92; transform: scale(1.09); }

  .post-card:hover .card-title { color: var(--color-accent); }

  .card-placeholder {
    width: 100%;
    aspect-ratio: 3 / 2;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in oklch, var(--color-accent) 22%, transparent), transparent 60%),
      var(--color-paper-3);
  }

  .post-card--lg .card-placeholder { aspect-ratio: 16 / 9; }
  .post-card--sm .card-placeholder { aspect-ratio: 4 / 3; }
  .post-card--xs .card-placeholder { aspect-ratio: 1 / 1; }

  .card-body {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .post-card--lg .card-body { padding: 1rem 1.1rem 1.2rem; }
  .post-card--sm .card-body { padding: 0.7rem 0.8rem 0.9rem; }
  .post-card--xs .card-body { padding: 0.5rem 0.55rem 0.6rem; gap: 0; }

  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.3;
    margin: 0;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms var(--ease-out, ease);
  }

  .post-card--lg .card-title { font-size: 1.25rem; -webkit-line-clamp: 2; letter-spacing: -0.01em; }
  .post-card--sm .card-title { font-size: 0.875rem; }
  .post-card--xs .card-title { font-size: 0.75rem; line-height: 1.25; -webkit-line-clamp: 2; font-weight: 700; }

  .card-excerpt {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 60ch;
  }
  .card-excerpt :global(p) { margin: 0; }

  .card-meta {
    margin-top: auto;
    padding-top: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-byline {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-avatar {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .card-date {
    flex-shrink: 0;
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }
</style>
