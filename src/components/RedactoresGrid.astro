---
import type { Redactor } from '../lib/wordpress';

interface Props {
  redactores: Redactor[];
}

const { redactores } = Astro.props;
---

<div class="redactores-grid">
  {redactores.map(redactor => (
    <div class="redactor-card">
      <div class="redactor-header">
        {redactor.avatarUrl ? (
          <img src={redactor.avatarUrl} alt="" class="redactor-avatar" />
        ) : (
          <div class="redactor-avatar redactor-avatar--placeholder" aria-hidden="true"></div>
        )}
        <span class="redactor-name">{redactor.name}</span>
      </div>

      {redactor.post && (
        <a href={redactor.post.uri} class="redactor-post">
          {redactor.post.featuredImage ? (
            <img
              src={redactor.post.featuredImage.sourceUrl}
              alt=""
              loading="lazy"
              class="redactor-post-img"
            />
          ) : (
            <div class="redactor-post-placeholder" aria-hidden="true"></div>
          )}
          <span class="redactor-post-title" set:html={redactor.post.title} />
        </a>
      )}

      {redactor.reelUrl && (
        <div class="redactor-reel" data-reel-slug={redactor.slug} data-reel-fallback={redactor.reelUrl}>
          <div class="redactor-reel-loading" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="redactor-reel-icon" aria-hidden="true">
              <path fill="currentColor" d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>
      )}
      {!redactor.reelUrl && !redactor.blankReel && (
        <div class="redactor-reel redactor-reel--placeholder">
          <svg viewBox="0 0 24 24" class="redactor-reel-icon" aria-hidden="true">
            <path fill="currentColor" d="M8 5v14l11-7z" />
          </svg>
          <span>Reel próximamente</span>
        </div>
      )}
    </div>
  ))}
</div>

<script>
  // Resuelve los vídeos reales de los reels contra /api/redactor-reels.json
  // en el cliente: el mediaUrl que da la API de Instagram es una URL de CDN
  // firmada con caducidad, así que no se puede guardar en el build estático
  // — hay que pedirla fresca en cada visita.
  const slots = document.querySelectorAll<HTMLElement>('.redactor-reel[data-reel-slug]');
  if (slots.length > 0) {
    fetch('/api/redactor-reels.json')
      .then(res => (res.ok ? res.json() : {}))
      .then((bySlug: Record<string, { mediaUrl: string; thumbnailUrl: string | null }>) => {
        slots.forEach(slot => {
          const slug = slot.dataset.reelSlug;
          const reel = slug ? bySlug[slug] : undefined;
          const fallbackUrl = slot.dataset.reelFallback;

          // El backend a veces resuelve la miniatura pero no el vídeo en sí
          // (mediaUrl vacío) — en vez de un <video src=""> roto, se enlaza
          // directamente al reel en Instagram sobre la miniatura.
          if (!reel?.mediaUrl) {
            if (!reel?.thumbnailUrl || !fallbackUrl) return;

            const link = document.createElement('a');
            link.className = 'redactor-reel-fallback';
            link.href = fallbackUrl;
            link.target = '_blank';
            link.rel = 'noopener';
            link.style.backgroundImage = `url(${reel.thumbnailUrl})`;

            const icon = document.createElement('span');
            icon.className = 'redactor-reel-fallback-icon';
            icon.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>';
            link.append(icon);

            slot.replaceChildren(link);
            return;
          }

          const video = document.createElement('video');
          video.className = 'redactor-reel-video';
          video.src = reel.mediaUrl;
          if (reel.thumbnailUrl) video.poster = reel.thumbnailUrl;
          video.controls = true;
          video.playsInline = true;
          video.preload = 'none';

          slot.replaceChildren(video);
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .redactores-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 60rem) {
    .redactores-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 34rem) {
    .redactores-grid { grid-template-columns: 1fr; }
  }

  .redactor-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem;
    border-radius: var(--radius-card, 12px);
    background: var(--color-paper-2);
  }

  .redactor-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .redactor-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .redactor-avatar--placeholder { background: var(--color-paper-3); }

  .redactor-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .redactor-post {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    border-radius: calc(var(--radius-card, 12px) - 4px);
    overflow: hidden;
  }

  .redactor-post-img {
    /* Imagen completa, sin recortar — las carátulas del "Top 10" suelen
       venir cuadradas y el 4:3 anterior les comía el borde superior/inferior. */
    display: block;
    width: 100%;
    height: auto;
    transition: opacity var(--dur-short, 220ms) var(--ease-out, ease);
  }

  .redactor-post:hover .redactor-post-img { opacity: 0.88; }

  .redactor-post-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in oklch, var(--color-accent) 22%, transparent), transparent 60%),
      var(--color-paper-3);
  }

  .redactor-post-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
    text-align: center;
    margin: 0.35rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms var(--ease-out, ease);
  }

  .redactor-post:hover .redactor-post-title { color: var(--color-accent); }

  .redactor-reel {
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: calc(var(--radius-card, 12px) - 4px);
    overflow: hidden;
    background: var(--color-paper-3);
  }

  .redactor-reel-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .redactor-reel-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .redactor-reel-fallback-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: color-mix(in oklch, black 55%, transparent);
    color: #fff;
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .redactor-reel-fallback-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .redactor-reel-fallback:hover .redactor-reel-fallback-icon { transform: scale(1.1); }

  .redactor-reel-loading,
  .redactor-reel--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    height: 100%;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .redactor-reel--placeholder { border: 1px dashed var(--color-rule); }

  .redactor-reel-icon {
    width: 1.75rem;
    height: 1.75rem;
    opacity: 0.5;
  }
</style>
