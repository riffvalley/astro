---
import type { Redactor } from '../lib/wordpress';

interface Props {
  redactores: Redactor[];
}

const { redactores } = Astro.props;
---

<div class="redactores-grid">
  {redactores.map(redactor => (
    <div class="redactor-card">
      <div class="redactor-header">
        {redactor.avatarUrl ? (
          <img src={redactor.avatarUrl} alt="" class="redactor-avatar" />
        ) : (
          <div class="redactor-avatar redactor-avatar--placeholder" aria-hidden="true"></div>
        )}
        <span class="redactor-name">{redactor.name}</span>
      </div>

      {redactor.post && (
        <a href={redactor.post.uri} class="redactor-post">
          {redactor.post.featuredImage ? (
            <img
              src={redactor.post.featuredImage.sourceUrl}
              alt=""
              loading="lazy"
              class="redactor-post-img"
            />
          ) : (
            <div class="redactor-post-placeholder" aria-hidden="true"></div>
          )}
          <span class="redactor-post-title" set:html={redactor.post.title} />
        </a>
      )}

      {redactor.reelUrl && (
        <div class="redactor-reel" data-reel-slug={redactor.slug} data-reel-fallback={redactor.reelUrl}>
          <div class="redactor-reel-loading" aria-hidden="true">Cargando…</div>
        </div>
      )}
      {!redactor.reelUrl && !redactor.blankReel && (
        <div class="redactor-reel redactor-reel--placeholder">
          <svg viewBox="0 0 24 24" class="redactor-reel-icon" aria-hidden="true">
            <path fill="currentColor" d="M8 5v14l11-7z" />
          </svg>
          <span>Reel próximamente</span>
        </div>
      )}
    </div>
  ))}
</div>

<script>
  // El vídeo real (mediaUrl) del backend no siempre llega — a veces resuelve
  // la miniatura pero no el vídeo. En vez de dos rutas distintas (vídeo
  // embebido vs. fallback), todas las tarjetas se tratan igual: miniatura +
  // botón que enlaza al reel en Instagram. La miniatura es una URL de CDN
  // firmada con caducidad, así que se pide fresca en cada visita en vez de
  // guardarla en el build estático.
  const slots = document.querySelectorAll<HTMLElement>('.redactor-reel[data-reel-slug]');
  if (slots.length > 0) {
    fetch('/api/redactor-reels.json')
      .then(res => (res.ok ? res.json() : {}))
      .then((bySlug: Record<string, { thumbnailUrl: string | null }>) => {
        slots.forEach(slot => {
          const slug = slot.dataset.reelSlug;
          const reel = slug ? bySlug[slug] : undefined;
          const fallbackUrl = slot.dataset.reelFallback;
          if (!reel?.thumbnailUrl || !fallbackUrl) return;

          const link = document.createElement('a');
          link.className = 'redactor-reel-link';
          link.href = fallbackUrl;
          link.target = '_blank';
          link.rel = 'noopener';

          const img = document.createElement('img');
          img.className = 'redactor-reel-thumb';
          img.src = reel.thumbnailUrl;
          img.alt = '';
          img.loading = 'lazy';

          const cta = document.createElement('span');
          cta.className = 'redactor-reel-cta';
          cta.textContent = 'Ver en Instagram →';

          link.append(img, cta);
          slot.replaceChildren(link);
        });
      })
      .catch(() => {});
  }
</script>

<style>
  .redactores-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 60rem) {
    .redactores-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 34rem) {
    .redactores-grid { grid-template-columns: 1fr; }
  }

  .redactor-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem;
    border-radius: var(--radius-card, 12px);
    background: var(--color-paper-2);
  }

  .redactor-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .redactor-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .redactor-avatar--placeholder { background: var(--color-paper-3); }

  .redactor-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .redactor-post {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    border-radius: calc(var(--radius-card, 12px) - 4px);
    overflow: hidden;
  }

  .redactor-post-img {
    /* Imagen completa, sin recortar — las carátulas del "Top 10" suelen
       venir cuadradas y el 4:3 anterior les comía el borde superior/inferior. */
    display: block;
    width: 100%;
    height: auto;
    transition: opacity var(--dur-short, 220ms) var(--ease-out, ease);
  }

  .redactor-post:hover .redactor-post-img { opacity: 0.88; }

  .redactor-post-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in oklch, var(--color-accent) 22%, transparent), transparent 60%),
      var(--color-paper-3);
  }

  .redactor-post-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
    text-align: center;
    margin: 0.35rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms var(--ease-out, ease);
  }

  .redactor-post:hover .redactor-post-title { color: var(--color-accent); }

  .redactor-reel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .redactor-reel-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .redactor-reel-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius-card, 12px) - 4px);
    transition: opacity var(--dur-short, 220ms) var(--ease-out, ease);
  }

  .redactor-reel-link:hover .redactor-reel-thumb { opacity: 0.88; }

  .redactor-reel-cta {
    align-self: center;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    transition: background 160ms var(--ease-out, ease);
  }

  .redactor-reel-link:hover .redactor-reel-cta {
    background: color-mix(in oklch, var(--color-accent) 22%, transparent);
  }

  .redactor-reel-loading,
  .redactor-reel--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    aspect-ratio: 4 / 5;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .redactor-reel--placeholder { border: 1px dashed var(--color-rule); }

  .redactor-reel-icon {
    width: 1.75rem;
    height: 1.75rem;
    opacity: 0.5;
  }
</style>
