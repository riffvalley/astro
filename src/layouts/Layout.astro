---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { WP_BASE_URL } from '../lib/wordpressClient';

interface Props {
  seo?: string;
  title?: string;
}

const { seo, title = 'Riff Valley' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {seo ? <Fragment set:html={seo} /> : <title>{title}</title>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&display=swap" />
    <link rel="stylesheet" href={`${WP_BASE_URL}/wp-includes/css/dist/block-library/style.min.css`} />
    <!-- Atmospheric es oscuro por defecto; .light es la alternativa opt-in -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      if (saved === 'light' || (!saved && prefersLight)) {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
