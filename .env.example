# Base URL del backend (sin /api final) que consumen nationalReleases.ts,
# discs.ts, instagram.ts y telegram.ts.
HOST_API=http://localhost:3000

# Clave de la API de Google Calendar (lectura de los 19 calendarios de la
# agenda de conciertos, ver src/lib/agendaCalendars.ts).
GOOGLE_CALENDAR_API_KEY=

# Base URL de WordPress (sin ruta final). Por defecto https://www.riffvalley.es
# si se deja vacío — solo hace falta rellenarlo cuando WordPress se mude a un
# subdominio propio (p.ej. wordpress.riffvalley.es) y riffvalley.es pase a
# servir este frontend directamente.
WP_BASE_URL=
